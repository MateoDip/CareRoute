# Copiar a .env.local y completar. Nunca commitear .env.local.

# Supabase (Project Settings → API). La anon key es pública por diseño.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base de datos (Supabase → Connect → ORM)
# Transaction pooler, puerto 6543, con ?pgbouncer=true
DATABASE_URL=
# Direct connection, puerto 5432 (migraciones)
DIRECT_URL=

# OpenAI — sugerencia de urgencia (clase 7). Solo servidor: nunca NEXT_PUBLIC_.
OPENAI_API_KEY=
# Opcional, solo para probar el timeout: OPENAI_BASE_URL=https://10.255.255.1/v1

# Solo local: cuentas de Google reales a las que `npm run db:seed` les da cada rol,
# para poder iniciar sesión como admin, derivante o receptor.
SEED_EMAIL_ADMIN=
SEED_EMAIL_DERIVANTE=
SEED_EMAIL_RECEPTOR=
