generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// ENUMS (Listas cerradas de valores)
// ==========================================

enum RolUsuario {
  ADMIN
  MEDICO_DERIVANTE
  MEDICO_RECEPTOR
}

enum NivelComplejidad {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

enum TipoUnidad {
  UTI
  UCO
  SALA_COMUN
  GUARDIA
}

enum TipoRecurso {
  RESPIRADOR
  MONITOR_MULTIPARAMETRICO
  DESFIBRILADOR
  BOMBA_INFUSION
}

enum EstadoRecurso {
  OPERATIVO
  EN_MANTENIMIENTO
  FUERA_DE_SERVICIO
}

enum EstadoSolicitud {
  PENDIENTE
  EVALUANDO
  APROBADA
  RECHAZADA
  EN_CURSO
  FINALIZADA
}

enum NivelUrgencia {
  BAJO
  MEDIO
  ALTO
  CRITICO
}

enum EstadoTripulacion {
  EN_BASE
  EN_TRANSITO_ORIGEN
  EN_TRANSITO_DESTINO
  REGRESANDO
}

enum EventoBitacora {
  SALIDA_BASE
  LLEGADA_ORIGEN
  PACIENTE_A_BORDO
  LLEGADA_DESTINO
  COMPLICACION_CLINICA
}

// ==========================================
// ENTIDADES
// ==========================================

model Usuario {
  id            String     @id @default(cuid())
  email         String     @unique
  nombre        String
  rol           RolUsuario
  centroSaludId String?

  centroSalud CentroSalud? @relation(fields: [centroSaludId], references: [id], onDelete: Restrict)

  @@index([centroSaludId])
}

model CentroSalud {
  id               String           @id @default(cuid())
  nombre           String
  nivelComplejidad NivelComplejidad
  ubicacion        String

  usuarios               Usuario[]
  unidadesCuidados       UnidadCuidados[]
  recursosEspecializados RecursoEspecializado[]
  solicitudesOrigen      SolicitudTraslado[]    @relation("CentroOrigen")
  solicitudesDestino     SolicitudTraslado[]    @relation("CentroDestino")
}

model UnidadCuidados {
  id               String     @id @default(cuid())
  centroSaludId    String
  tipo             TipoUnidad
  camasDisponibles Int        @default(0)

  centroSalud CentroSalud @relation(fields: [centroSaludId], references: [id], onDelete: Cascade)

  @@index([centroSaludId])
}

model RecursoEspecializado {
  id             String        @id @default(cuid())
  centroSaludId  String
  tipo           TipoRecurso
  estado         EstadoRecurso
  ultimaRevision DateTime

  centroSalud CentroSalud @relation(fields: [centroSaludId], references: [id], onDelete: Cascade)

  @@index([centroSaludId])
}

model SolicitudTraslado {
  id              String          @id @default(cuid())
  centroOrigenId  String
  centroDestinoId String?
  pacienteDni     String
  estado          EstadoSolicitud @default(PENDIENTE)
  fechaSolicitud  DateTime        @default(now())

  centroOrigen      CentroSalud         @relation("CentroOrigen", fields: [centroOrigenId], references: [id], onDelete: Restrict)
  centroDestino     CentroSalud?        @relation("CentroDestino", fields: [centroDestinoId], references: [id], onDelete: Restrict)
  evaluacionTriaje  EvaluacionTriaje?
  tripulacionMedica TripulacionMedica[]
  registrosBitacora RegistroBitacora[]

  @@index([centroOrigenId])
  @@index([centroDestinoId])
}

model EvaluacionTriaje {
  id                    String        @id @default(cuid())
  solicitudId           String        @unique
  frecuenciaCardiaca    Int
  presionSistolica      Int
  presionDiastolica     Int
  nivelUrgenciaSugerido NivelUrgencia

  solicitudTraslado SolicitudTraslado @relation(fields: [solicitudId], references: [id], onDelete: Cascade)

  // No necesita @@index porque @unique ya crea uno automáticamente
}

model TripulacionMedica {
  id                    String            @id @default(cuid())
  solicitudId           String
  patenteAmbulancia     String
  paramedicoResponsable String
  estado                EstadoTripulacion

  solicitudTraslado SolicitudTraslado  @relation(fields: [solicitudId], references: [id], onDelete: Restrict)
  registrosBitacora RegistroBitacora[]

  @@index([solicitudId])
}

model RegistroBitacora {
  id                  String         @id @default(cuid())
  solicitudId         String
  tripulacionMedicaId String?
  fechaHora           DateTime       @default(now())
  evento              EventoBitacora
  observaciones       String?

  solicitudTraslado SolicitudTraslado  @relation(fields: [solicitudId], references: [id], onDelete: Restrict)
  tripulacionMedica TripulacionMedica? @relation(fields: [tripulacionMedicaId], references: [id], onDelete: Restrict)

  @@index([solicitudId])
  @@index([tripulacionMedicaId])
}
