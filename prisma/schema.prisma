generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// ENUMS (Listas cerradas de valores)
// ==========================================

enum RolUsuario {
  ADMIN
  MEDICO_DERIVANTE
  MEDICO_RECEPTOR
}

enum NivelComplejidad {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

enum TipoUnidad {
  UTI
  UCO
  SALA_COMUN
  GUARDIA
}

enum TipoRecurso {
  RESPIRADOR
  MONITOR_MULTIPARAMETRICO
  DESFIBRILADOR
  BOMBA_INFUSION
}

enum EstadoRecurso {
  OPERATIVO
  EN_MANTENIMIENTO
  FUERA_DE_SERVICIO
}

enum EstadoSolicitud {
  PENDIENTE
  EVALUANDO
  APROBADA
  RECHAZADA
  EN_CURSO
  FINALIZADA
}

enum NivelUrgencia {
  BAJO
  MEDIO
  ALTO
  CRITICO
}

enum EstadoTripulacion {
  EN_BASE
  EN_TRANSITO_ORIGEN
  EN_TRANSITO_DESTINO
  REGRESANDO
}

/// De dónde salió el nivel de urgencia de una evaluación (clase 7, spec §6).
enum OrigenNivelUrgencia {
  IA
  MANUAL
}

enum EventoBitacora {
  SALIDA_BASE
  LLEGADA_ORIGEN
  PACIENTE_A_BORDO
  LLEGADA_DESTINO
  COMPLICACION_CLINICA
}

// ==========================================
// ENTIDADES
//
// Orden de cada modelo: id → campos propios → relaciones (objeto + FK) →
// timestamps → índices. Timestamps: `creadaEn` y `actualizadaEn` ("la fila fue
// creada / actualizada"), el mismo nombre en todas las tablas.
// ==========================================

model Usuario {
  id            String     @id @default(cuid())
  email         String     @unique
  nombre        String
  rol           RolUsuario
  centroSaludId String?

  centroSalud CentroSalud? @relation(fields: [centroSaludId], references: [id], onDelete: Restrict)

  creadaEn      DateTime @default(now())
  actualizadaEn DateTime @updatedAt

  @@index([centroSaludId])
}

model CentroSalud {
  id               String           @id @default(cuid())
  nombre           String
  nivelComplejidad NivelComplejidad
  ubicacion        String

  usuarios               Usuario[]
  unidadesCuidados       UnidadCuidados[]
  recursosEspecializados RecursoEspecializado[]
  solicitudesOrigen      SolicitudTraslado[]    @relation("CentroOrigen")
  solicitudesDestino     SolicitudTraslado[]    @relation("CentroDestino")

  creadaEn      DateTime @default(now())
  actualizadaEn DateTime @updatedAt
}

model UnidadCuidados {
  id               String     @id @default(cuid())
  tipo             TipoUnidad
  camasDisponibles Int        @default(0)

  centroSaludId String
  centroSalud   CentroSalud @relation(fields: [centroSaludId], references: [id], onDelete: Cascade)

  creadaEn      DateTime @default(now())
  actualizadaEn DateTime @updatedAt

  @@index([centroSaludId])
}

model RecursoEspecializado {
  id             String        @id @default(cuid())
  tipo           TipoRecurso
  estado         EstadoRecurso
  ultimaRevision DateTime

  centroSaludId String
  centroSalud   CentroSalud @relation(fields: [centroSaludId], references: [id], onDelete: Cascade)

  creadaEn      DateTime @default(now())
  actualizadaEn DateTime @updatedAt

  @@index([centroSaludId])
}

/// `fechaSolicitud` cumple el papel de `creadaEn`: es el momento en que la fila nace.
model SolicitudTraslado {
  id              String          @id @default(cuid())
  pacienteDni     String
  estado          EstadoSolicitud @default(PENDIENTE)
  fechaSolicitud  DateTime        @default(now())
  /// H3: "se registra la fecha y hora de la decisión". Null hasta que se aprueba.
  fechaAprobacion DateTime?

  centroOrigenId  String
  centroOrigen    CentroSalud  @relation("CentroOrigen", fields: [centroOrigenId], references: [id], onDelete: Restrict)
  /// Lo elige el médico derivante desde el ranking (HU04). Null hasta entonces.
  centroDestinoId String?
  centroDestino   CentroSalud? @relation("CentroDestino", fields: [centroDestinoId], references: [id], onDelete: Restrict)

  evaluacionTriaje        EvaluacionTriaje?
  asignacionesTripulacion AsignacionTripulacion[]
  registrosBitacora       RegistroBitacora[]

  actualizadaEn DateTime @updatedAt

  @@index([centroOrigenId])
  @@index([centroDestinoId])
}

model EvaluacionTriaje {
  id                    String              @id @default(cuid())
  frecuenciaCardiaca    Int
  presionSistolica      Int
  presionDiastolica     Int
  nivelUrgenciaSugerido NivelUrgencia
  /// IA si lo sugirió OpenAI, MANUAL si lo eligió el médico (spec §6, regla 2).
  origenNivel           OrigenNivelUrgencia @default(MANUAL)

  solicitudId       String            @unique
  solicitudTraslado SolicitudTraslado @relation(fields: [solicitudId], references: [id], onDelete: Cascade)

  creadaEn      DateTime @default(now())
  actualizadaEn DateTime @updatedAt

  // No necesita @@index: @unique ya crea uno.
}

/// Una tripulación (ambulancia + paramédico) hace muchos traslados, y un traslado
/// puede necesitar más de una (relevo en rutas largas): relación N-N con
/// SolicitudTraslado a través de AsignacionTripulacion.
model TripulacionMedica {
  id                    String            @id @default(cuid())
  patenteAmbulancia     String
  paramedicoResponsable String
  estado                EstadoTripulacion

  asignaciones      AsignacionTripulacion[]
  registrosBitacora RegistroBitacora[]

  creadaEn      DateTime @default(now())
  actualizadaEn DateTime @updatedAt
}

/// Tabla intermedia de la N-N SolicitudTraslado ↔ TripulacionMedica. Es entidad
/// y no una tabla implícita de Prisma porque tiene un dato propio: cuándo se asignó.
model AsignacionTripulacion {
  asignadaEn DateTime @default(now())

  solicitudId         String
  solicitudTraslado   SolicitudTraslado @relation(fields: [solicitudId], references: [id], onDelete: Restrict)
  tripulacionMedicaId String
  tripulacionMedica   TripulacionMedica @relation(fields: [tripulacionMedicaId], references: [id], onDelete: Restrict)

  // La clave compuesta impide asignar dos veces la misma tripulación al mismo
  // traslado, y su índice ya cubre los filtros por solicitudId.
  @@id([solicitudId, tripulacionMedicaId])
  @@index([tripulacionMedicaId])
}

/// Log de auditoría: no se edita ni se borra, por eso no tiene `actualizadaEn`.
model RegistroBitacora {
  id            String         @id @default(cuid())
  fechaHora     DateTime       @default(now())
  evento        EventoBitacora
  observaciones String?

  solicitudId         String
  solicitudTraslado   SolicitudTraslado  @relation(fields: [solicitudId], references: [id], onDelete: Restrict)
  tripulacionMedicaId String?
  tripulacionMedica   TripulacionMedica? @relation(fields: [tripulacionMedicaId], references: [id], onDelete: Restrict)

  creadaEn DateTime @default(now())

  @@index([solicitudId])
  @@index([tripulacionMedicaId])
}
