# Entorno de las pruebas e2e (clase 13). Se commitea: no tiene ningún secreto real.
#
# Lo lee playwright.config.ts (e2e/entorno.ts) y se lo pasa a la app, al servidor
# de Auth local y a Prisma. Estos valores le ganan a los de .env.local, así una
# corrida de pruebas nunca toca la base de Supabase ni llama a OpenAI.
#
# Base: Postgres local en Docker (ver README, sección Pruebas). Si el host no es
# local, playwright.config.ts se niega a arrancar.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/careroute_e2e
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/careroute_e2e

# Supabase Auth de pruebas (e2e/auth-local.ts): valida la firma de cada token
# con E2E_JWT_SECRET, que solo existe acá. La app no conoce el secreto: le
# pregunta al servidor de Auth, igual que en producción.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=anon-key-solo-pruebas
E2E_JWT_SECRET=secreto-solo-para-pruebas-e2e-no-se-usa-en-produccion

# OpenAI apunta a una ruta que no existe del servidor de Auth local: la IA
# "no responde" siempre y se recorre el caso de error de HU02 (nivel a mano).
OPENAI_API_KEY=clave-falsa-solo-pruebas
OPENAI_BASE_URL=http://127.0.0.1:54321/openai-no-disponible

# Mails de prueba del seed: los mismos que usan las sesiones de e2e/sesiones.ts.
SEED_EMAIL_ADMIN=admin@careroute.test
SEED_EMAIL_DERIVANTE=derivante@heca.test
SEED_EMAIL_RECEPTOR=receptor@centenario.test

# Build de la app aparte del de `npm run dev` (next.config.ts): las variables
# NEXT_PUBLIC_ quedan fijadas en el build y no tienen que mezclarse.
NEXT_DIST_DIR=.next-e2e
PUERTO_E2E=3100
