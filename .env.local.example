# ----------------------------------------------------------------------------
# CareRoute — plantilla de variables de entorno
# Copiar como .env.local y completar. .env.local NUNCA se commitea.
# ----------------------------------------------------------------------------

# --- Supabase: API (Project Settings → API) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor. Ignora RLS: jamás exponerla en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase: base de datos (botón Connect del proyecto) -------------------
# Transaction pooler (puerto 6543) — para la app en serverless / Vercel.
DATABASE_URL=postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct connection (puerto 5432) — para migraciones y herramientas locales.
DIRECT_URL=postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# --- IA: sugerencia de nivel de urgencia ------------------------------------
AI_API_KEY=

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
