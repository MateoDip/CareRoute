# Copiar a docs/.env (ignorado por git) y completar con la cookie de sesión de
# Supabase de cada cuenta de prueba: iniciá sesión en la app, DevTools →
# Application → Cookies → sb-<proyecto>-auth-token. Pegá "nombre=valor".
# Si la cookie viene partida (.0 y .1), pegá las dos separadas por "; ".
SESION_DERIVANTE=
SESION_RECEPTOR=
SESION_ADMIN=
