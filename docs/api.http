###############################################################################
# CareRoute — pruebas de la API sin interfaz
#
# Se corre con la extensión "REST Client" de VS Code (humao.rest-client). Cada
# bloque que empieza con ### es un pedido: aparece "Send Request" arriba.
#
# LO IMPORTANTE ES EL STATUS CODE. Cada request tiene el esperado en su título.
# Un 500 donde debería haber un 409 es un bug aunque "parezca" un error.
#
# ANTES DE EMPEZAR
#  1. `npm run db:seed` — deja cada dato en el estado que esperan estas pruebas.
#     Con SEED_EMAIL_ADMIN / _DERIVANTE / _RECEPTOR en .env.local, el seed les
#     da ese rol y centro a esos mails (tienen que ser cuentas de Google reales).
#  2. Iniciar sesión con Google en {{base}} con cada una de esas cuentas y copiar
#     la cookie sb-...-auth-token (DevTools → Application → Cookies) en
#     docs/.env, siguiendo docs/.env.example. docs/.env no se commitea.
#  3. Correr el archivo en orden: algunas requests cambian el estado de otras.
#     Para volver a empezar: npm run db:seed.
###############################################################################

@base = http://localhost:3000
# Para probar contra producción, comentá la línea de arriba y descomentá esta:
# @base = https://care-route-beta.vercel.app

# Sesiones (cookies de Supabase Auth), una por rol. Salen de docs/.env.
@sesionDerivante = {{$dotenv SESION_DERIVANTE}}
@sesionReceptor = {{$dotenv SESION_RECEPTOR}}
@sesionAdmin = {{$dotenv SESION_ADMIN}}

# Datos del seed (prisma/seed.ts)
@solicitudPendiente = solicitud-pendiente-1
@solicitudEvaluada = solicitud-evaluada-1
@solicitudPropuesta = solicitud-propuesta-1
@solicitudAprobada = solicitud-ok-1
@solicitudDeOtroCentro = solicitud-ajena-1
@centroOrigen = centro-origen-1
@centroConCamas = centro-destino-1
@centroSinCamas = centro-sin-camas-1
@unidadUtiReceptor = unidad-destino-uti
@unidadDeOtroCentro = unidad-origen-uti


###############################################################################
# CLASE 6 — Las tres pruebas de autorización (local Y producción)
###############################################################################

### Sin sesión → 401
GET {{base}}/api/solicitudes

### Rol incorrecto: el derivante intenta aprobar → 403 + rolesHabilitados
POST {{base}}/api/solicitudes/{{solicitudPropuesta}}/aprobacion
Cookie: {{sesionDerivante}}

### Recurso ajeno: solicitud de otro centro → 404 (no 200 con datos, no 403)
GET {{base}}/api/solicitudes/{{solicitudDeOtroCentro}}
Cookie: {{sesionDerivante}}

### Usuario recién registrado, sin centro → 403 "Pedíselo a un administrador"
### (entrá con una cuenta de Google que no esté en el seed y usá su cookie)
# GET {{base}}/api/solicitudes
# Cookie: sb-...-auth-token=...

### El admin no participa del flujo clínico → 403
GET {{base}}/api/solicitudes
Cookie: {{sesionAdmin}}


###############################################################################
# GET /api/solicitudes   (HU06, HU07)
###############################################################################

### Éxito → 200, solicitudes del centro del derivante
GET {{base}}/api/solicitudes
Cookie: {{sesionDerivante}}

### HU06 del receptor: lo que le propusieron y tiene que responder → 200
GET {{base}}/api/solicitudes?rol=destino&estado=EVALUANDO
Cookie: {{sesionReceptor}}

### Filtro inválido → 400
GET {{base}}/api/solicitudes?estado=INVENTADO
Cookie: {{sesionDerivante}}


###############################################################################
# POST /api/solicitudes   (HU01)
###############################################################################

### Éxito → 201. Guarda el id para la sección de la clase 7
# @name nueva
POST {{base}}/api/solicitudes
Content-Type: application/json
Cookie: {{sesionDerivante}}

{ "pacienteDni": "99700001" }

### Campos inyectados → 201, pero Zod descarta "estado" y "centroOrigenId":
### la respuesta tiene que mostrar PENDIENTE y centro-origen-1
POST {{base}}/api/solicitudes
Content-Type: application/json
Cookie: {{sesionDerivante}}

{ "pacienteDni": "99700002", "estado": "APROBADA", "centroOrigenId": "centro-destino-1" }

### DNI inválido → 400
POST {{base}}/api/solicitudes
Content-Type: application/json
Cookie: {{sesionDerivante}}

{ "pacienteDni": "abc" }

### DNI faltante → 400
POST {{base}}/api/solicitudes
Content-Type: application/json
Cookie: {{sesionDerivante}}

{}

### Rol incorrecto: el receptor no crea solicitudes → 403
POST {{base}}/api/solicitudes
Content-Type: application/json
Cookie: {{sesionReceptor}}

{ "pacienteDni": "99700003" }


###############################################################################
# GET / PATCH /api/solicitudes/:id
###############################################################################

### Ficha con triaje y tripulaciones (N-N) → 200
GET {{base}}/api/solicitudes/{{solicitudAprobada}}
Cookie: {{sesionDerivante}}

### No existe → 404
GET {{base}}/api/solicitudes/no-existe
Cookie: {{sesionDerivante}}

### Corregir DNI de una PENDIENTE → 200
PATCH {{base}}/api/solicitudes/{{solicitudPendiente}}
Content-Type: application/json
Cookie: {{sesionDerivante}}

{ "pacienteDni": "99887766" }

### Body inválido → 400
PATCH {{base}}/api/solicitudes/{{solicitudPendiente}}
Content-Type: application/json
Cookie: {{sesionDerivante}}

{ "pacienteDni": "1" }

### Ya no está PENDIENTE → 409 + estadoActual
PATCH {{base}}/api/solicitudes/{{solicitudEvaluada}}
Content-Type: application/json
Cookie: {{sesionDerivante}}

{ "pacienteDni": "99112233" }


###############################################################################
# POST /api/solicitudes/:id/evaluacion   (HU02)
###############################################################################

### Signos fuera de rango → 400
POST {{base}}/api/solicitudes/{{solicitudPendiente}}/evaluacion
Content-Type: application/json
Cookie: {{sesionDerivante}}

{ "frecuenciaCardiaca": 88, "presionSistolica": 900, "presionDiastolica": 60 }

### Falta un signo vital → 400
POST {{base}}/api/solicitudes/{{solicitudPendiente}}/evaluacion
Content-Type: application/json
Cookie: {{sesionDerivante}}

{ "frecuenciaCardiaca": 88, "presionDiastolica": 60 }

### Ya evaluada (1 a 1) → 409 + estadoActual
POST {{base}}/api/solicitudes/{{solicitudEvaluada}}/evaluacion
Content-Type: application/json
Cookie: {{sesionDerivante}}

{ "frecuenciaCardiaca": 75, "presionSistolica": 120, "presionDiastolica": 80, "nivelUrgenciaSugerido": "BAJO" }

### Éxito SIN nivel: lo sugiere la IA → 201 + origenNivel "IA"
POST {{base}}/api/solicitudes/{{solicitudPendiente}}/evaluacion
Content-Type: application/json
Cookie: {{sesionDerivante}}

{ "frecuenciaCardiaca": 130, "presionSistolica": 85, "presionDiastolica": 50 }


###############################################################################
# GET /api/solicitudes/:id/candidatos   (HU03)
###############################################################################

### Ranking → 200, centros con cama UTI, ordenados por puntaje
GET {{base}}/api/solicitudes/{{solicitudEvaluada}}/candidatos
Cookie: {{sesionDerivante}}

### Sin triaje → 409 (la "nueva" de arriba todavía no fue evaluada)
GET {{base}}/api/solicitudes/{{nueva.response.body.id}}/candidatos
Cookie: {{sesionDerivante}}

### No existe → 404
GET {{base}}/api/solicitudes/no-existe/candidatos
Cookie: {{sesionDerivante}}


###############################################################################
# POST /api/solicitudes/:id/destino   (HU04 — el derivante elige del ranking)
###############################################################################

### Rol incorrecto: el receptor no elige destino → 403
POST {{base}}/api/solicitudes/{{solicitudEvaluada}}/destino
Content-Type: application/json
Cookie: {{sesionReceptor}}

{ "centroDestinoId": "{{centroConCamas}}" }

### Body inválido → 400
POST {{base}}/api/solicitudes/{{solicitudEvaluada}}/destino
Content-Type: application/json
Cookie: {{sesionDerivante}}

{ "centroDestinoId": "" }

### Destino = origen → 409
POST {{base}}/api/solicitudes/{{solicitudEvaluada}}/destino
Content-Type: application/json
Cookie: {{sesionDerivante}}

{ "centroDestinoId": "{{centroOrigen}}" }

### Destino sin camas UTI → 409 "Capacidad agotada" + tiposConCamaLibre ["UCO"]
POST {{base}}/api/solicitudes/{{solicitudEvaluada}}/destino
Content-Type: application/json
Cookie: {{sesionDerivante}}

{ "centroDestinoId": "{{centroSinCamas}}" }

### Centro de destino inexistente → 404
POST {{base}}/api/solicitudes/{{solicitudEvaluada}}/destino
Content-Type: application/json
Cookie: {{sesionDerivante}}

{ "centroDestinoId": "no-existe" }

### Solicitud sin triaje (PENDIENTE) → 409 + transicionesPosibles
POST {{base}}/api/solicitudes/{{nueva.response.body.id}}/destino
Content-Type: application/json
Cookie: {{sesionDerivante}}

{ "centroDestinoId": "{{centroConCamas}}" }

### Éxito → 200, centroDestinoId asignado, sigue EVALUANDO
POST {{base}}/api/solicitudes/{{solicitudEvaluada}}/destino
Content-Type: application/json
Cookie: {{sesionDerivante}}

{ "centroDestinoId": "{{centroConCamas}}" }


###############################################################################
# POST /api/solicitudes/:id/aprobacion   (HU04 — OPERACIÓN CORE, sin body)
###############################################################################

### No existe, o no fue propuesta a su centro → 404
POST {{base}}/api/solicitudes/no-existe/aprobacion
Cookie: {{sesionReceptor}}

### Éxito → 201: APROBADA, cama reservada y fechaAprobacion registrada
POST {{base}}/api/solicitudes/{{solicitudPropuesta}}/aprobacion
Cookie: {{sesionReceptor}}

### Ya aprobada → 409 + estadoActual + transicionesPosibles
POST {{base}}/api/solicitudes/{{solicitudPropuesta}}/aprobacion
Cookie: {{sesionReceptor}}

### Sin cama en el instante exacto → 409 "Capacidad agotada"
### Para verlo: poné la UTI en 0 y aprobá la que eligió destino más arriba
PATCH {{base}}/api/unidades/{{unidadUtiReceptor}}
Content-Type: application/json
Cookie: {{sesionReceptor}}

{ "camasDisponibles": 0 }

###
POST {{base}}/api/solicitudes/{{solicitudEvaluada}}/aprobacion
Cookie: {{sesionReceptor}}


###############################################################################
# POST /api/solicitudes/:id/rechazo   (spec §6)
###############################################################################

### El derivante intenta rechazar una APROBADA → 403 + rolesHabilitados
POST {{base}}/api/solicitudes/{{solicitudAprobada}}/rechazo
Cookie: {{sesionDerivante}}

### No existe → 404
POST {{base}}/api/solicitudes/no-existe/rechazo
Cookie: {{sesionReceptor}}

### El receptor rechaza la APROBADA → 200: RECHAZADA y la cama UCO vuelve
POST {{base}}/api/solicitudes/{{solicitudAprobada}}/rechazo
Cookie: {{sesionReceptor}}

### Rechazarla otra vez → 409 + estadoActual + transicionesPosibles
POST {{base}}/api/solicitudes/{{solicitudAprobada}}/rechazo
Cookie: {{sesionReceptor}}


###############################################################################
# GET /api/solicitudes/:id/bitacora   (HU07)
###############################################################################

### Éxito → 200
GET {{base}}/api/solicitudes/{{solicitudAprobada}}/bitacora
Cookie: {{sesionDerivante}}

### De otro centro → 404
GET {{base}}/api/solicitudes/{{solicitudDeOtroCentro}}/bitacora
Cookie: {{sesionDerivante}}


###############################################################################
# PATCH /api/unidades/:id   (HU05)
###############################################################################

### Éxito → 200
PATCH {{base}}/api/unidades/{{unidadUtiReceptor}}
Content-Type: application/json
Cookie: {{sesionReceptor}}

{ "camasDisponibles": 4 }

### Camas negativas → 400
PATCH {{base}}/api/unidades/{{unidadUtiReceptor}}
Content-Type: application/json
Cookie: {{sesionReceptor}}

{ "camasDisponibles": -1 }

### Unidad de otro centro → 404
PATCH {{base}}/api/unidades/{{unidadDeOtroCentro}}
Content-Type: application/json
Cookie: {{sesionReceptor}}

{ "camasDisponibles": 2 }

### Rol incorrecto: el derivante no actualiza camas → 403
PATCH {{base}}/api/unidades/{{unidadDeOtroCentro}}
Content-Type: application/json
Cookie: {{sesionDerivante}}

{ "camasDisponibles": 2 }


###############################################################################
# CentroSalud — CRUD completo (ADMIN)
###############################################################################

### Listar (cualquier usuario logueado) → 200
GET {{base}}/api/centros
Cookie: {{sesionDerivante}}

### Crear → 201
# @name centroNuevo
POST {{base}}/api/centros
Content-Type: application/json
Cookie: {{sesionAdmin}}

{ "nombre": "Centro de Prueba", "nivelComplejidad": "BAJA", "ubicacion": "Calle Falsa 123" }

### Crear con datos inválidos → 400
POST {{base}}/api/centros
Content-Type: application/json
Cookie: {{sesionAdmin}}

{ "nombre": "X", "nivelComplejidad": "ENORME", "ubicacion": "" }

### Crear siendo derivante → 403
POST {{base}}/api/centros
Content-Type: application/json
Cookie: {{sesionDerivante}}

{ "nombre": "Centro de Prueba", "nivelComplejidad": "BAJA", "ubicacion": "Calle Falsa 123" }

### Ver → 200
GET {{base}}/api/centros/{{centroNuevo.response.body.id}}
Cookie: {{sesionDerivante}}

### Ver inexistente → 404
GET {{base}}/api/centros/no-existe
Cookie: {{sesionDerivante}}

### Editar → 200
PATCH {{base}}/api/centros/{{centroNuevo.response.body.id}}
Content-Type: application/json
Cookie: {{sesionAdmin}}

{ "nivelComplejidad": "MEDIA" }

### Editar sin campos → 400
PATCH {{base}}/api/centros/{{centroNuevo.response.body.id}}
Content-Type: application/json
Cookie: {{sesionAdmin}}

{}

### Borrar un centro con usuarios y derivaciones → 409 + dependencias (Restrict)
DELETE {{base}}/api/centros/{{centroOrigen}}
Cookie: {{sesionAdmin}}

### Borrar → 204 (sus unidades y recursos caen en cascada)
DELETE {{base}}/api/centros/{{centroNuevo.response.body.id}}
Cookie: {{sesionAdmin}}

### Borrarlo otra vez → 404
DELETE {{base}}/api/centros/{{centroNuevo.response.body.id}}
Cookie: {{sesionAdmin}}


###############################################################################
# Usuarios (ADMIN) — cómo un usuario nuevo recibe rol y centro
###############################################################################

### Listar → 200. Copiá el id del usuario al que querés asignarle rol y centro
GET {{base}}/api/usuarios
Cookie: {{sesionAdmin}}

### Listar siendo receptor → 403
GET {{base}}/api/usuarios
Cookie: {{sesionReceptor}}

### Asignar rol y centro → 200 (reemplazá PEGAR_ID)
PATCH {{base}}/api/usuarios/PEGAR_ID
Content-Type: application/json
Cookie: {{sesionAdmin}}

{ "rol": "MEDICO_RECEPTOR", "centroSaludId": "{{centroSinCamas}}" }

### Rol inexistente → 400
PATCH {{base}}/api/usuarios/PEGAR_ID
Content-Type: application/json
Cookie: {{sesionAdmin}}

{ "rol": "DIOS" }

### Centro inexistente → 404
PATCH {{base}}/api/usuarios/PEGAR_ID
Content-Type: application/json
Cookie: {{sesionAdmin}}

{ "centroSaludId": "no-existe" }

### El admin se quita el rol a sí mismo → 409 (reemplazá con el id del admin)
PATCH {{base}}/api/usuarios/ID_DEL_ADMIN
Content-Type: application/json
Cookie: {{sesionAdmin}}

{ "rol": "MEDICO_DERIVANTE" }


###############################################################################
# CLASE 7 — Servicio externo (OpenAI) y qué pasa cuando falla   (HU02, spec §8)
#
# Se usa la solicitud "nueva" creada al principio (sigue PENDIENTE, sin triaje).
# Si ya la evaluaste, volvé a correr "POST /api/solicitudes → Éxito".
###############################################################################

### CREDENCIAL ROTA: cambiá una letra de OPENAI_API_KEY en .env.local y reiniciá
### `npm run dev` → 502 + ingresoManualRequerido: true + nivelesPosibles
### Esperado:
###  - responde en ~1 s con "No pudimos obtener la sugerencia de urgencia..."
###  - en la terminal: "openai: el proveedor respondió con error" { status: 401,
###    detalle: "Incorrect API key provided..." }
###  - no se guardó nada: el GET de abajo muestra PENDIENTE y evaluacionTriaje null
POST {{base}}/api/solicitudes/{{nueva.response.body.id}}/evaluacion
Content-Type: application/json
Cookie: {{sesionDerivante}}

{ "frecuenciaCardiaca": 130, "presionSistolica": 85, "presionDiastolica": 50 }

### TIMEOUT: con la clave buena, agregá OPENAI_BASE_URL=https://10.255.255.1/v1 en
### .env.local (una IP que no responde) y reiniciá → 502 a los ~8 s, no se cuelga
### Esperado en la terminal: "openai: no se pudo obtener la sugerencia"
###   { error: "TimeoutError: The operation was aborted due to timeout" }
POST {{base}}/api/solicitudes/{{nueva.response.body.id}}/evaluacion
Content-Type: application/json
Cookie: {{sesionDerivante}}

{ "frecuenciaCardiaca": 130, "presionSistolica": 85, "presionDiastolica": 50 }

### Sistema consistente después de la falla → 200, PENDIENTE, sin evaluación
GET {{base}}/api/solicitudes/{{nueva.response.body.id}}
Cookie: {{sesionDerivante}}

### Camino manual (con la IA todavía rota) → 201 + origenNivel "MANUAL"
### No llama a OpenAI. Al terminar: clave buena y sin OPENAI_BASE_URL.
POST {{base}}/api/solicitudes/{{nueva.response.body.id}}/evaluacion
Content-Type: application/json
Cookie: {{sesionDerivante}}

{ "frecuenciaCardiaca": 130, "presionSistolica": 85, "presionDiastolica": 50, "nivelUrgenciaSugerido": "CRITICO" }
